{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openrouter-radar",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "durable_objects": { "bindings": [{ "name": "SCHEDULER", "class_name": "RadarScheduler" }] },
  "migrations": [{ "tag": "radar-scheduler-v1", "new_sqlite_classes": ["RadarScheduler"] }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "openrouter-radar",
    "database_id": "1487e863-77b6-4c56-b448-52718ace08d7",
    "migrations_dir": "migrations"
  }],
  "assets": { "directory": "./web/dist", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "APP_ORIGIN": "https://openrouter-radar.zhajiahe1994.workers.dev",
    "MAIL_FROM": "Radar <notifications@example.com>",
    "OPEN_SIGNUP": "false",
    "MAX_MODELS_PER_TICK": "15"
  }
}
