{
  "name": "openrouter-radar",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/build-brand-assets.mjs && vite build --config web/vite.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check && npm run build",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "lint": "eslint src tests web/src web/vite.config.ts",
    "format": "prettier --write src tests web/src web/vite.config.ts README.md CONTRIBUTING.md docs .github package.json eslint.config.mjs",
    "format:check": "prettier --check eslint.config.mjs .prettierrc.json web/src/tokens.css docs/ui-design.md CONTRIBUTING.md .github/pull_request_template.md",
    "test:visual": "node scripts/build-brand-assets.mjs && playwright test --config playwright.config.ts",
    "compare:visual": "node e2e/compare-screenshots.mjs"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "zod": "^4.1.0",
    "decimal.js": "^10.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/charts": "^8.3.18",
    "recharts": "^2.15.4",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "tsx": "^4.20.0",
    "vite": "^8.3.4",
    "wrangler": "^4.45.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.46.0",
    "prettier": "^3.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@playwright/test": "^1.56.1",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "@resvg/resvg-js": "2.6.2"
  }
}
